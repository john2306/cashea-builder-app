# ====== Producción — Cashea Hub / IziDeploy ======
# Copiar a .env.prod y completar. NUNCA commitear .env.prod.
# Correr:  docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- Dominios ---
BUILDER_DOMAIN=izideploy.com          # builder + API (https://izideploy.com)
APP_DOMAIN=app.izideploy.com          # apps desplegadas: https://<slug>.app.izideploy.com
PUBLIC_BASE_URL=https://izideploy.com
ACME_EMAIL=admin@izideploy.com        # email para Let's Encrypt

# --- DigitalOcean DNS (certificados WILDCARD vía DNS-01) ---
# Token de API de DO con permiso de escritura en DNS (crea un token en API → Tokens).
DO_AUTH_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Base de datos ---
POSTGRES_PASSWORD=pon-un-password-fuerte-aleatorio

# --- Sesión / Admin ---
# Generar: openssl rand -hex 48
SESSION_SECRET=cambia-esto-por-48-bytes-hex-aleatorios
ADMIN_EMAILS=tu@correo.com            # CSV de admins (ven la sección Logs)

# --- IA ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
LLM_DAILY_CALL_CAP=500

# --- OAuth Google (login + conectores Google) ---
# En Google Cloud Console, Redirect URIs autorizadas:
#   https://izideploy.com/auth/google/callback
#   https://izideploy.com/api/mcp/oauth/callback
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# --- Conectores OAuth opcionales ---
# Notion redirect URI: https://izideploy.com/api/mcp/oauth/callback
NOTION_CLIENT_ID=...
NOTION_CLIENT_SECRET=...
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
